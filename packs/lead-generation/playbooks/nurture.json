          "type": "string",
          "default": "new"
        },
        "lastTouch": {
          "type": "string"
        },
        "budgetBand": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "throttle": {
      "maxPerRecipientPerDay": 1,
      "cooldownHours": 48
    },
    "triggers": [
      {
        "type": "event",
        "eventType": "LEAD_FOLLOWUP"
      },
      {
        "type": "campaign",
        "where": {
          "campaignPlaybookKey": {
            "eq": "lead.followup"
          }
        }
      }
    ]

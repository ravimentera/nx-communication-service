      }
    },
    "triggers": [{ "type": "event", "eventType": "FEEDBACK_ACKNOWLEDGEMENT" }],
    "metadata": {
      "$comment": "Ships INACTIVE — see medspa.treatment-followup-ai. New capability, not a port."
    }
  },

  {
    "key": "medspa.feedback-escalation",
    "name": "Feedback escalation",
    "description": "From feedback-analysis.service.ts. Adverse feedback goes to staff, not to the patient — so there is no recipient and the target is the tenant's escalation contacts.",
    "priority": 5,
    "approvalPolicyKey": "system.transactional",
    "contentSource": { "kind": "template", "templateKey": "medspa.staff-alert.email" },
    "channelPlan": [
      {
        "channel": "email",
        "templateKey": "medspa.staff-alert.email",
        "fixedTarget": "$config.emergencyContacts",
        "priority": "URGENT"
      },
      {
        "channel": "slack",
        "templateKey": "medspa.staff-alert.slack",
        "fixedTarget": "$config.slackChannels.staffAlerts",
        "priority": "URGENT"
      }
    ],
    "dataContract": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "urgency": { "type": "string", "default": "HIGH" }
      }
    },
    "triggers": [{ "type": "event", "eventType": "FEEDBACK_ESCALATION" }]
  },


  {
    "key": "medspa.feedback-acknowledgement",
    "name": "Feedback acknowledgement",
    "description": "From feedback-analysis.service.ts. The model writes the reply, so a provider reviews it — the persistence in that service is stubbed demo code (Seam D) and is NOT ported; only the playbook shape is.",
    "priority": 30,
    "isActive": false,
    "approvalPolicyKey": "medspa.provider-always",

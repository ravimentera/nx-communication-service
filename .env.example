# =============================================================================
# @mentera/outreach-server
#
# Only src/config/index.ts reads these. Everything else takes config by
# injection from the composition root (enforced by eslint).
#
# REQUIRED (boot fails without them): DATABASE_URL, NODE_ENV, PORT
# =============================================================================

# --- server ------------------------------------------------------------------
PORT=5007
HOST=0.0.0.0
NODE_ENV=development
SERVICE_NAME=outreach-server

# --- db ----------------------------------------------------------------------
# Plain postgres only. The RDS Data API path from the source service is dropped.
DATABASE_URL=postgres://outreach:outreach@localhost:5433/outreach
DB_SSL=false
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=outreach:
SKIP_REDIS=false

# --- queue -------------------------------------------------------------------
SKIP_QUEUE=false
DISABLE_NOTIFICATION_QUEUE=false
EVENT_QUEUE_NAME=outreach-events
EVENT_PROCESSING_CONCURRENCY=5
NOTIFICATION_CONCURRENCY=5
MAX_CONCURRENCY=10
RETRY_LIMIT=5

# --- auth --------------------------------------------------------------------
# gateway (implemented) | apikey (stub, P12) | jwt (501 Not Implemented)
AUTH_MODE=gateway
GATEWAY_ONLY=true

# --- llm ---------------------------------------------------------------------
# bedrock | stub. `stub` returns deterministic synthetic content and needs no
# AWS account — it exists so every AI path (content generation, drafts with
# approvals, campaign copy, the MCP generateDraft tool) can be exercised
# locally. NEVER set it outside local testing; it logs a warning at boot.
LLM_PROVIDER=bedrock
# `stub` only. Make every model call throw, to exercise the outage paths.
STUB_LLM_FAIL=false
# `stub` only. Artificial latency in ms.
STUB_LLM_LATENCY_MS=0
AWS_REGION=us-east-1
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_BEDROCK_AGENT_ID=
AWS_BEDROCK_AGENT_ALIAS_ID=
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=2

# --- channels ----------------------------------------------------------------
# Env credentials are the LAST-RESORT fallback. Per-tenant credentials come from
# tenant_channel_configs / agent_channel_configs in the database (P3).
# CHANNEL_DRY_RUN replaces the implicit NODE_ENV !== 'production' checks that the
# source service scattered through the twilio and sendgrid adapters.
CHANNEL_DRY_RUN=true

SENDGRID_API_KEY=
DEFAULT_EMAIL_SENDER=noreply@example.com
SENDGRID_FROM_NAME=Outreach

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_SERVICE=
SMTP_AUTH_TYPE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

FCM_API_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=

# --- context -----------------------------------------------------------------
# Read ONLY by adapters/context/mentera.provider.ts (P5). A non-Mentera tenant
# leaves these empty and uses the inline context provider.
PATIENT_SERVICE_URL=
PROVIDER_SERVICE_URL=
CONTEXT_CACHE_TTL_S=300

# --- storage -----------------------------------------------------------------
S3_MEMORY_BUCKET=
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./memory-store
TEMPLATES_PATH=./templates
ASSETS_PATH=./assets
IMAGE_STORAGE_PATH=./uploads

# --- compliance --------------------------------------------------------------
UNSUBSCRIBE_BASE_URL=http://localhost:5007/unsubscribe
DEFAULT_TIMEZONE=America/Los_Angeles
ENFORCE_QUIET_HOURS=true
RETENTION_DRY_RUN=true
COMPLIANCE_SHADOW_MODE=true

# --- observability -----------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# --- campaigns ---------------------------------------------------------------
CAMPAIGN_GENERATE_CONCURRENCY=5

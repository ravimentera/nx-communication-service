{
  "name": "@mentera/outreach-server",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant outreach engine — channels, playbooks, approvals, compliance",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "npm test -- tests/unit",
    "test:contract": "npm test -- tests/contract",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "migrate:print": "node scripts/print-migrations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.775.0",
    "@aws-sdk/client-bedrock-runtime": "^3.775.0",
    "@aws-sdk/client-s3": "^3.777.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@sendgrid/mail": "^8.1.4",
    "@slack/web-api": "^7.9.0",
    "axios": "^1.8.4",
    "bullmq": "^5.44.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^4.15.3",
    "multer": "^2.0.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "twilio": "^5.5.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.24",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "testcontainers": "^10.18.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
